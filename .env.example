# Postgres. Local, Docker, Neon or Supabase: any of them.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payroll_ms?schema=public"

# Signs the session cookie. At least 32 random characters, and a
# DIFFERENT one in production: anyone who has this can mint a session for
# any user in the database.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Email or WhatsApp for sending payslips, when that is built.
PAYSLIP_CHANNEL=
PAYSLIP_TOKEN=
